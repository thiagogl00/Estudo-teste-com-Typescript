{
  "name": "automacao-qa",
  "main": "dist/aula25/server.js",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "dev": "npm run type-check && tsx src/aula25/server.ts",
    "dev:server": "tsx src/aula25/server.ts",
    "build": "tsc",
    "start": "node .",
    "test": "playwright test",
